# Environnement d'exécution : "development" | "staging" | "production".
# Tant que APP_ENV n'est pas "production", le bandeau « Version de développement – données fictives » est affiché.
# En "staging", les liens WhatsApp sont sans destinataire (https://wa.me/?text=...).
# Aucun secret ici : le fichier .env.local n'est jamais committé.
APP_ENV=development
